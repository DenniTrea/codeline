  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/session-file-store": "^1.2.6",
    "@types/supertest": "^7.2.1",
    "socket.io-client": "^4.8.4",
