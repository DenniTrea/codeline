# Template only. Real credentials belong in backend/.env, never frontend variables.
# Leave blank to run the UI without connecting to a database.
DATABASE_URL=
# Existing VM uses a self-signed certificate: require encrypts without server verification.
# Prefer verify-full plus a trusted DATABASE_CA_FILE when available.
DATABASE_SSL_MODE=require
DATABASE_CA_FILE=
# 3000 is reserved for the existing private PostgREST service.
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5173/auth/callback
# Opt-in only; also requires NODE_ENV=development and a loopback frontend origin.
DEV_ROLE_TESTING=false
