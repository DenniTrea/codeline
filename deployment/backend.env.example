# Copy to /etc/codeline/backend.env on the VM. Never commit the filled file.
NODE_ENV=production
DEV_ROLE_TESTING=false
PORT=3001
FRONTEND_ORIGIN=https://YOUR_HOSTNAME
MICROSOFT_REDIRECT_URI=https://YOUR_HOSTNAME/auth/callback
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SESSION_SECRET=
SESSION_DIR=/var/lib/codeline/sessions
# Use the existing denidb database on the same VM. URL-encode password characters.
DATABASE_URL=
# Existing self-signed TLS compatibility. Prefer verify-full with a trusted CA.
DATABASE_SSL_MODE=require
DATABASE_CA_FILE=
